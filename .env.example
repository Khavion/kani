# Kani local configuration. Copy to .env and adjust. Everything runs offline.
PORT=3000
OLLAMA_URL=http://localhost:11434
MODEL=qwen3:8b
ALT_MODEL=gemma3:12b
VISION_MODEL=gemma3:12b
# SQLite database file (production path: Postgres, see README)
DB_PATH=data/kani.db
# whisperX CLI. Leave empty to auto-detect (.local/venv-whisper/bin/whisperx, then PATH).
WHISPERX_BIN=
WHISPER_MODEL=small
# Per-generation timeout for Ollama calls, in milliseconds
LLM_TIMEOUT_MS=60000
# Scheduler tick (real milliseconds)
SCHEDULER_TICK_MS=15000
